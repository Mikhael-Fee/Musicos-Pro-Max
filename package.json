{
  "name": "musicos-pro-max",
  "version": "3.2.1",
  "private": true,
  "description": "Aprendizagem musical para violão, teclado e baixo, com ritmo, revisão e estudo diário",
  "scripts": {
    "dev": "python3 -m http.server 5173 --bind 0.0.0.0",
